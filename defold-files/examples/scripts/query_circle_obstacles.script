local cam                   = require("defold-files.examples.scripts.lib.cam")
local const                 = require("defold-files.examples.scripts.lib.const")

local MAX_CIRCLE_OBSTACLES  = 200
local MIN_OBSTACLE_RADIUS   = 64
local MAX_OBSTACLE_RADIUS   = 128
local QUERY_RADIUS          = 560
local WORLD_HALF_W          = 2500
local WORLD_HALF_H          = 1600

local QUERY_MODE_IN_RADIUS  = 1
local QUERY_MODE_COLLIDING  = 2

local COLOR_MISS            = vmath.vector4(88 / 255, 92 / 255, 104 / 255, 1)
local COLOR_IN_RADIUS       = vmath.vector4(70 / 255, 220 / 255, 125 / 255, 1)
local COLOR_COLLIDING       = vmath.vector4(245 / 255, 150 / 255, 70 / 255, 1)
local COLOR_QUERY_IN_RADIUS = vmath.vector4(110 / 255, 245 / 255, 160 / 255, 0.45)
local COLOR_QUERY_COLLIDING = vmath.vector4(255 / 255, 190 / 255, 90 / 255, 0.45)

local mouse_pos             = vmath.vector3()
local obstacles             = {}
local obstacles_by_id       = {}
local obstacle_count        = 0
local query_id
local query_sprite_url
local query_position
local query_mode

local function set_tint(sprite_url, color)
	go.set(sprite_url, "tint", color)
end

local function set_circle_size(sprite_url, radius)
	go.set(sprite_url, "size", vmath.vector3(radius * 2, radius * 2, 0))
end

local function random_range(min_value, max_value)
	return min_value + rnd.double(const.RND_ID) * (max_value - min_value)
end

local function random_obstacle_position(radius)
	return vmath.vector3(
		random_range(-WORLD_HALF_W + radius, WORLD_HALF_W - radius),
		random_range(-WORLD_HALF_H + radius, WORLD_HALF_H - radius),
		0
	)
end

local function mode_hit_color(mode)
	return mode == QUERY_MODE_IN_RADIUS and COLOR_IN_RADIUS or COLOR_COLLIDING
end

local function mode_query_color(mode)
	return mode == QUERY_MODE_IN_RADIUS and COLOR_QUERY_IN_RADIUS or COLOR_QUERY_COLLIDING
end

local function set_query_mode(mode)
	query_mode = mode
	set_tint(query_sprite_url, mode_query_color(mode))

	for i = 1, obstacle_count do
		local obstacle = obstacles[i]
		if obstacle.hit then
			set_tint(obstacle.sprite_url, mode_hit_color(mode))
		end
	end
end

local function add_obstacle_visual(obs_id, position, radius)
	local instance = factory.create("/factory#circle_obs", position)
	local sprite_url = msg.url(instance)
	sprite_url.fragment = "sprite"

	set_circle_size(sprite_url, radius)
	set_tint(sprite_url, COLOR_MISS)

	local obstacle = {
		id         = obs_id,
		instance   = instance,
		sprite_url = sprite_url,
		radius     = radius,
		hit        = false,
		next_hit   = false,
	}

	obstacle_count = obstacle_count + 1
	obstacles[obstacle_count] = obstacle
	obstacles_by_id[obs_id] = obstacle
end

local function spawn_obstacles()
	for i = 1, MAX_CIRCLE_OBSTACLES do
		local radius = random_range(MIN_OBSTACLE_RADIUS, MAX_OBSTACLE_RADIUS)
		local position = random_obstacle_position(radius)
		local obs_id = crowd.add_circle_obstacle(position.x, position.y, radius)

		if obs_id == crowd.INVALID_ID then
			error("failed to add circle obstacle", 2)
		end

		add_obstacle_visual(obs_id, position, radius)
	end

	crowd.process_circle_obstacles()
end

local function clear_next_hits()
	for i = 1, obstacle_count do
		obstacles[i].next_hit = false
	end
end

local function mark_query_hits(obstacle_ids, count)
	for i = 1, count do
		local obstacle = obstacles_by_id[obstacle_ids[i]]
		if obstacle then
			obstacle.next_hit = true
		end
	end
end

local function apply_hit_tints()
	local hit_color = mode_hit_color(query_mode)

	for i = 1, obstacle_count do
		local obstacle = obstacles[i]
		if obstacle.hit ~= obstacle.next_hit then
			obstacle.hit = obstacle.next_hit
			set_tint(obstacle.sprite_url, obstacle.hit and hit_color or COLOR_MISS)
		end
	end
end

local function update_query()
	query_position = go.get_position(query_id)
	local obstacle_ids
	local count

	clear_next_hits()

	if query_mode == QUERY_MODE_IN_RADIUS then
		obstacle_ids, count = crowd.query_circle_obstacles_in_radius(query_position.x, query_position.y, QUERY_RADIUS)
	else
		obstacle_ids, count = crowd.query_circle_obstacles_colliding(query_position.x, query_position.y, QUERY_RADIUS)
	end

	mark_query_hits(obstacle_ids, count)
	apply_hit_tints()
end

function init(self)
	msg.post("@render:", "clear_color", { color = vmath.vector4(67 / 255, 49 / 255, 67 / 255, 0) })
	msg.post(".", "acquire_input_focus")

	obstacles = {}
	obstacles_by_id = {}
	obstacle_count = 0

	crowd.init(0, 1, 0, MAX_CIRCLE_OBSTACLES, 1)

	query_id = go.get_id("/query")
	query_sprite_url = msg.url(query_id)
	query_sprite_url.fragment = "sprite"
	query_position = vmath.vector3(200, 200, 0.1)

	go.set_position(query_position, query_id)
	set_circle_size(query_sprite_url, QUERY_RADIUS)

	spawn_obstacles()
	set_query_mode(QUERY_MODE_IN_RADIUS)
	update_query()
end

function final(self)
	crowd.destroy()
end

function update(self, dt)
	update_query()
end

function on_input(self, action_id, action)
	cam.input(action_id)

	if action_id == const.TRIGGER.KEY_SPACE and action.pressed then
		local next_mode = query_mode == QUERY_MODE_IN_RADIUS and QUERY_MODE_COLLIDING or QUERY_MODE_IN_RADIUS
		set_query_mode(next_mode)
		update_query()
	end
	if action.screen_x then
		mouse_pos.x = action.screen_x
		mouse_pos.y = action.screen_y
		mouse_pos.z = 0
		query_position = camera.screen_to_world(mouse_pos, const.CAMERA)
		query_position.z = 0.1
		go.set_position(query_position, query_id)
		update_query()
	end
end
