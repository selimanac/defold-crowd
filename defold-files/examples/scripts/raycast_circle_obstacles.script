local cam                  = require("defold-files.examples.scripts.lib.cam")
local const                = require("defold-files.examples.scripts.lib.const")

local MAX_CIRCLE_OBSTACLES = 280
local RAY_COUNT            = 20
local RAY_RESULT_CAP       = 128
local RAY_RADIUS           = 0
local MIN_OBSTACLE_RADIUS  = 22
local MAX_OBSTACLE_RADIUS  = 95
local WORLD_HALF_W         = 2500
local WORLD_HALF_H         = 1600
local WORLD_W              = WORLD_HALF_W * 2
local WORLD_H              = WORLD_HALF_H * 2
local WORLD_DIAG           = math.sqrt(WORLD_W * WORLD_W + WORLD_H * WORLD_H)

local COLOR_OBSTACLE_MISS  = vmath.vector4(78 / 255, 82 / 255, 92 / 255, 0.72)
local COLOR_OBSTACLE_HIT   = vmath.vector4(54 / 255, 156 / 255, 235 / 255, 0.86)
local COLOR_RAY_MISS       = vmath.vector4(90 / 255, 110 / 255, 135 / 255, 0.42)
local COLOR_RAY_HIT        = vmath.vector4(255 / 255, 218 / 255, 85 / 255, 0.86)
local COLOR_FIRST_HIT      = vmath.vector4(255 / 255, 92 / 255, 70 / 255, 1)
local COLOR_LATER_HIT      = vmath.vector4(255 / 255, 245 / 255, 145 / 255, 1)

local obstacles            = {}
local obstacles_by_id      = {}
local obstacle_count       = 0
local rays                 = {}
local hit_markers          = {}
local hit_marker_count     = 0

local function set_tint(sprite_url, color)
	go.set(sprite_url, "tint", color)
end

local function set_circle_size(sprite_url, radius)
	go.set(sprite_url, "size", vmath.vector3(radius * 2, radius * 2, 0))
end

local function random_range(min_value, max_value)
	return min_value + rnd.double(const.RND_ID) * (max_value - min_value)
end

local function make_sprite_instance(position, radius, tint)
	local instance = factory.create("/factory#circle_obs", position)
	local sprite_url = msg.url(instance)
	sprite_url.fragment = "sprite"

	set_circle_size(sprite_url, radius)
	set_tint(sprite_url, tint)

	return instance, sprite_url
end

local function random_obstacle_position(radius)
	return vmath.vector3(
		random_range(-WORLD_HALF_W + radius, WORLD_HALF_W - radius),
		random_range(-WORLD_HALF_H + radius, WORLD_HALF_H - radius),
		0
	)
end

local function add_obstacle_visual(obs_id, position, radius)
	local instance, sprite_url = make_sprite_instance(position, radius, COLOR_OBSTACLE_MISS)
	local obstacle = {
		id         = obs_id,
		instance   = instance,
		sprite_url = sprite_url,
		position   = position,
		radius     = radius,
		hit        = false,
	}

	obstacle_count = obstacle_count + 1
	obstacles[obstacle_count] = obstacle
	obstacles_by_id[obs_id] = obstacle
end

local function spawn_obstacles()
	for i = 1, MAX_CIRCLE_OBSTACLES do
		local radius = random_range(MIN_OBSTACLE_RADIUS, MAX_OBSTACLE_RADIUS)
		local position = random_obstacle_position(radius)
		local obs_id = crowd.add_circle_obstacle(position.x, position.y, radius)

		if obs_id == crowd.INVALID_ID then
			error("failed to add circle obstacle", 2)
		end

		add_obstacle_visual(obs_id, position, radius)
	end

	crowd.process_circle_obstacles()
end

local function generate_rays()
	local short_edge_end = math.floor(RAY_COUNT / 3)
	local long_center_end = math.floor(RAY_COUNT * 2 / 3)
	local short_len_min = 360
	local short_len_max = 980
	local dense_half_w = WORLD_HALF_W * 0.25
	local dense_half_h = WORLD_HALF_H * 0.25

	for i = 1, RAY_COUNT do
		local ray = {
			radius = RAY_RADIUS,
			hit    = false,
			count  = 0,
		}

		if i <= short_edge_end then
			local angle = rnd.double(const.RND_ID) * const.TWO_PI
			local dir = vmath.vector3(math.cos(angle), math.sin(angle), 0)
			local half = dir * (random_range(short_len_min, short_len_max) * 0.5)
			local center = vmath.vector3(
				random_range(-WORLD_HALF_W * 0.90, WORLD_HALF_W * 0.90),
				random_range(-WORLD_HALF_H * 0.90, WORLD_HALF_H * 0.90),
				0
			)
			ray.start_position = center - half
			ray.end_position = center + half
		elseif i <= long_center_end then
			local angle = rnd.double(const.RND_ID) * const.TWO_PI
			local dir = vmath.vector3(math.cos(angle), math.sin(angle), 0)
			local tangent = vmath.vector3(-dir.y, dir.x, 0)
			local offset = tangent * random_range(-WORLD_HALF_H * 0.35, WORLD_HALF_H * 0.35)
			local half = dir * (WORLD_DIAG * 0.5)
			ray.start_position = offset - half
			ray.end_position = offset + half
		else
			ray.start_position = vmath.vector3(random_range(-dense_half_w, dense_half_w), random_range(-dense_half_h, dense_half_h), 0)
			ray.end_position = vmath.vector3(random_range(-dense_half_w, dense_half_w), random_range(-dense_half_h, dense_half_h), 0)
		end

		rays[i] = ray
	end
end

local function delete_hit_markers()
	for i = 1, hit_marker_count do
		go.delete(hit_markers[i].instance)
		hit_markers[i] = nil
	end
	hit_marker_count = 0
end

local function clear_obstacle_hits()
	for i = 1, obstacle_count do
		local obstacle = obstacles[i]
		if obstacle.hit then
			obstacle.hit = false
			set_tint(obstacle.sprite_url, COLOR_OBSTACLE_MISS)
		end
	end
end

local function add_hit_marker(position, first_hit)
	position.z = first_hit and 0.25 or 0.2

	local radius = first_hit and 12 or 6.5
	local color = first_hit and COLOR_FIRST_HIT or COLOR_LATER_HIT
	local instance = make_sprite_instance(position, radius, color)

	hit_marker_count = hit_marker_count + 1
	hit_markers[hit_marker_count] = {
		instance = instance,
	}
end

local function mark_obstacle_hit(obs_id)
	local obstacle = obstacles_by_id[obs_id]
	if obstacle and not obstacle.hit then
		obstacle.hit = true
		set_tint(obstacle.sprite_url, COLOR_OBSTACLE_HIT)
	end
end

local function run_raycasts()
	delete_hit_markers()
	clear_obstacle_hits()

	for i = 1, RAY_COUNT do
		local ray = rays[i]
		local hits, count = crowd.raycast_circle_obstacles(
			ray.start_position.x,
			ray.start_position.y,
			ray.end_position.x,
			ray.end_position.y,
			RAY_RADIUS
		)

		ray.count = count
		ray.hit = count > 0

		local delta = ray.end_position - ray.start_position
		for h = 1, count do
			local hit = hits[h]
			local hit_position = ray.start_position + delta * hit.t

			mark_obstacle_hit(hit.id)
			add_hit_marker(hit_position, h == 1)
		end
	end
end

local function regenerate_raycasts()
	generate_rays()
	run_raycasts()
end

local function draw_rays()
	for i = 1, RAY_COUNT do
		local ray = rays[i]
		msg.post("@render:", "draw_line", {
			start_point = ray.start_position,
			end_point   = ray.end_position,
			color       = ray.hit and COLOR_RAY_HIT or COLOR_RAY_MISS,
		})
	end
end

function init(self)
	msg.post("@render:", "clear_color", { color = vmath.vector4(67 / 255, 49 / 255, 67 / 255, 0) })
	msg.post(".", "acquire_input_focus")

	obstacles = {}
	obstacles_by_id = {}
	obstacle_count = 0
	rays = {}
	hit_markers = {}
	hit_marker_count = 0

	crowd.init(0, 1, 0, MAX_CIRCLE_OBSTACLES, 1)
	crowd.set_max_circle_raycast_query(RAY_RESULT_CAP)

	spawn_obstacles()
	regenerate_raycasts()
end

function final(self)
	delete_hit_markers()
	crowd.destroy()
end

function update(self, dt)
	draw_rays()
end

function on_input(self, action_id, action)
	cam.input(action_id)

	if action_id == const.TRIGGER.KEY_SPACE and action.pressed then
		regenerate_raycasts()
	end
end
