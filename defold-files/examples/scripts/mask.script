local data           = require("defold-files.examples.scripts.lib.data")
local cam            = require("defold-files.examples.scripts.lib.cam")
local const          = require("defold-files.examples.scripts.lib.const")
local agent          = require("defold-files.examples.scripts.lib.agent")

local MAX_AGENTS     = 201
local MAX_WORKERS    = 1
local RUN_SIMULATION = false -- toggle run C/C++ or Lua -> false = lua

local LAYER_GROUND   = 2 ^ 0 -- bit 0 = 1
local LAYER_AIR      = 2 ^ 1 -- bit 1 = 2
local GOAL_COUNT     = 4
local GROUND_OBST    = { 256, 256, 128 }
local AIR_OBST       = { 64, 128, 128, 128, 256, 256 }

local ground_goals   = {}
local air_goals      = {}

local step_update    = crowd.do_step

function init(self)
	msg.post("@render:", "clear_color", { color = vmath.vector4(67 / 255, 49 / 255, 67 / 255, 0) })
	msg.post(".", "acquire_input_focus")

	crowd.init(MAX_AGENTS, 4, 6, 10, MAX_WORKERS)

	if RUN_SIMULATION then
		crowd.init_gameobjects()
	end
	crowd.run_simulation(RUN_SIMULATION)

	if MAX_WORKERS > 1 then
		step_update = crowd.do_step_parallel
	end

	-- ground targets
	for i = 1, GOAL_COUNT do
		table.insert(ground_goals, go.get_position("ground_target_" .. tostring(i)))
		table.insert(air_goals, go.get_position("air_target_" .. tostring(i)))
	end

	-- ground circle obst
	for i = 1, #GROUND_OBST do
		local circle_position = go.get_position("/ground_obst_" .. tostring(i))
		local ground_obst_id = crowd.add_circle_obstacle(circle_position.x, circle_position.y, GROUND_OBST[i])
		crowd.set_circle_obstacle_nav_mask(ground_obst_id, LAYER_GROUND)
	end

	-- air circle obst
	for i = 1, #AIR_OBST do
		local circle_position = go.get_position("/air_obst_" .. tostring(i))
		local air_obst_id     = crowd.add_circle_obstacle(circle_position.x, circle_position.y, AIR_OBST[i])
		crowd.set_circle_obstacle_nav_mask(air_obst_id, LAYER_AIR)
	end

	crowd.process_circle_obstacles()

	local rect_obst_vertex     = {
		{ x = 256.0, y = 0.0 },
		{ x = 256.0, y = 256 },
		{ x = 0.0,   y = 128 }
	}

	local ground_rect_obst_pos = go.get_position("/obst_rect_1")
	local ground_rect_obst     = {}

	for _, vertex in pairs(rect_obst_vertex) do
		table.insert(ground_rect_obst, { x = vertex.x + (ground_rect_obst_pos.x - 128), y = vertex.y + (ground_rect_obst_pos.y - 128) })
	end

	local rect_obst_id = crowd.add_obstacle(ground_rect_obst)
	crowd.set_obstacle_nav_mask(rect_obst_id, LAYER_GROUND)

	ground_rect_obst_pos = go.get_position("/obst_rect_2")
	ground_rect_obst = {}
	for _, vertex in pairs(rect_obst_vertex) do
		table.insert(ground_rect_obst, { x = vertex.x + (ground_rect_obst_pos.x - 128), y = vertex.y + (ground_rect_obst_pos.y - 128) })
	end
	rect_obst_id = crowd.add_obstacle(ground_rect_obst)
	crowd.set_obstacle_nav_mask(rect_obst_id, LAYER_GROUND)

	crowd.process_obstacles()

	-- Ground units
	for i = 1, GOAL_COUNT do
		agent.add(25, air_goals[i], ground_goals[i], RUN_SIMULATION, LAYER_GROUND, false)
	end

	-- Air units
	for i = 1, GOAL_COUNT do
		agent.add(25, ground_goals[i], air_goals[i], RUN_SIMULATION, LAYER_AIR, true)
	end
end

function final(self)
	crowd.destroy()
end

function update(self, dt)
	if RUN_SIMULATION or data.agent_count == 0 then
		return
	end

	crowd.set_time_step(dt)

	agent.set_preferred_velocities(dt)

	step_update()

	agent.update_game_objects()
end

function on_input(self, action_id, action)
	cam.input(action_id)
end
