local data                    = require("defold-files.examples.scripts.lib.data")
local cam                     = require("defold-files.examples.scripts.lib.cam")
local const                   = require("defold-files.examples.scripts.lib.const")
local agent                   = require("defold-files.examples.scripts.lib.agent")

local MAX_AGENTS              = 2500
local RUN_SIMULATION          = true -- toggle run C/C++ or Lua -> false = lua
local MAX_WORKERS             = 3

local FORM_RADIUS             = 4400
local QUERY_POINT_COUNT       = 150
local QUERY_RADIUS            = 350
local QUERY_VISUAL_Z          = 0.1

local COLOR_QUERY             = vmath.vector4(80 / 255, 180 / 255, 255 / 255, 0.25)
local COLOR_AGENT_BASE        = vmath.vector4(1, 1, 1, 1)
local COLOR_AGENT_HIT         = vmath.vector4(60 / 255, 150 / 255, 255 / 255, 1)

local step_update             = crowd.do_step
local query_points            = {}
local query_visuals           = {}
local query_visual_count      = 0
local highlighted_agents      = {}
local next_highlighted_agents = {}
local highlighted_count       = 0
local next_highlight_count    = 0

local function set_tint(sprite_url, color)
	go.set(sprite_url, "tint", color)
end

local function set_circle_size(sprite_url, radius)
	go.set(sprite_url, "size", vmath.vector3(radius * 2, radius * 2, 0))
end

local function add_query_visual(index, position)
	local instance = factory.create("/query_factory#query_go", position)
	local sprite_url = msg.url(instance)
	sprite_url.fragment = "sprite"

	set_circle_size(sprite_url, QUERY_RADIUS)
	set_tint(sprite_url, COLOR_QUERY)

	query_visual_count = query_visual_count + 1
	query_visuals[index] = {
		instance   = instance,
		sprite_url = sprite_url,
	}
end

local function set_query_point(index, position)
	query_points[index] = position

	local visual = query_visuals[index]
	if visual then
		go.set_position(position, visual.instance)
	else
		add_query_visual(index, position)
	end
end

local function generate_query_points()
	local query_area_radius = FORM_RADIUS * 1.55

	for i = 1, QUERY_POINT_COUNT do
		local angle = rnd.double(const.RND_ID) * const.TWO_PI
		local radius = math.sqrt(rnd.double(const.RND_ID)) * query_area_radius
		local position = vmath.vector3(math.cos(angle) * radius, math.sin(angle) * radius, QUERY_VISUAL_Z)

		set_query_point(i, position)
	end
end

local function add_next_highlight(temp_agent)
	if not temp_agent.next_query_hit then
		temp_agent.next_query_hit = true
		next_highlight_count = next_highlight_count + 1
		next_highlighted_agents[next_highlight_count] = temp_agent
	end
end

local function apply_highlights()
	for i = 1, highlighted_count do
		local temp_agent = highlighted_agents[i]
		if not temp_agent.next_query_hit then
			temp_agent.query_hit = false
			set_tint(temp_agent.sprite_url, COLOR_AGENT_BASE)
		end

		highlighted_agents[i] = nil
	end

	for i = 1, next_highlight_count do
		local temp_agent = next_highlighted_agents[i]
		if not temp_agent.query_hit then
			temp_agent.query_hit = true
			set_tint(temp_agent.sprite_url, COLOR_AGENT_HIT)
		end

		temp_agent.next_query_hit = false
		highlighted_agents[i] = temp_agent
		next_highlighted_agents[i] = nil
	end

	highlighted_count = next_highlight_count
	next_highlight_count = 0
end

local function update_radius_queries()
	for i = 1, highlighted_count do
		highlighted_agents[i].next_query_hit = false
	end

	for q = 1, QUERY_POINT_COUNT do
		local point = query_points[q]
		local agent_ids, count = crowd.query_agents_in_radius(point.x, point.y, QUERY_RADIUS)

		for i = 1, count do
			local temp_agent = data.agent_by_id[agent_ids[i]]
			if temp_agent then
				add_next_highlight(temp_agent)
			end
		end
	end

	apply_highlights()
end

function init(self)
	msg.post("@render:", "clear_color", { color = vmath.vector4(67 / 255, 49 / 255, 67 / 255, 0) })
	msg.post(".", "acquire_input_focus")

	query_points            = {}
	query_visuals           = {}
	query_visual_count      = 0
	highlighted_agents      = {}
	next_highlighted_agents = {}
	highlighted_count       = 0
	next_highlight_count    = 0

	crowd.init(MAX_AGENTS, 4, 0, 0, MAX_WORKERS)

	if RUN_SIMULATION then
		crowd.init_gameobjects()
	end

	crowd.run_simulation(RUN_SIMULATION)

	if MAX_WORKERS > 1 then
		step_update = crowd.do_step_parallel
	end

	agent.add(MAX_AGENTS, nil, nil, RUN_SIMULATION, nil, false, {
		layout = "opposite_circle",
		radius = FORM_RADIUS
	})

	generate_query_points()
end

function final(self)
	for i = 1, query_visual_count do
		local visual = query_visuals[i]
		if visual then
			go.delete(visual.instance)
		end
	end

	crowd.destroy()
end

function update(self, dt)
	if data.agent_count == 0 then
		return
	end

	if not RUN_SIMULATION then
		crowd.set_time_step(dt)

		agent.set_preferred_velocities(dt)

		step_update()
	end

	update_radius_queries()

	if not RUN_SIMULATION then
		agent.update_game_objects()
	end
end

function on_input(self, action_id, action)
	cam.input(action_id)

	if action_id == const.TRIGGER.KEY_SPACE and action.pressed then
		generate_query_points()
	end
end
