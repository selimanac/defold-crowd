local TRI_OBST       = {
	{ x = 0.0,   y = 0.0 },
	{ x = 488.0, y = 0.0 },
	{ x = 244.0, y = 488.0 },
}

local MAX_AGENTS     = 1200
local RUN_SIMULATION = false -- toggle run C/C++ or Lua -> false = lua
local MAX_WORKERS    = 1

local GOAL_COUNT     = 6
local goals          = {}

local step_update    = crowd.do_step

-- Debug draws
local function draw_arena_bounds(arena)
	local vertex_count = #arena

	for i = 1, vertex_count do
		local next_index  = (i % vertex_count) + 1
		local v_start     = arena[i]
		local v_end       = arena[next_index]
		local start_point = vmath.vector3(v_start.x, v_start.y, 0)
		local end_point   = vmath.vector3(v_end.x, v_end.y, 0)

		msg.post("@render:", "draw_line", {
			start_point = start_point,
			end_point = end_point,
			color = const.WALL_COLOR
		})
	end
end

local function draw_obstacles()
	local n = crowd.get_num_obstacle_vertices()
	if n == 0 then return end

	local visited = {}
	for i = 0, n - 1 do
		if not visited[i] then
			local x1, y1 = crowd.get_obstacle_vertex(i)
			local next_i = crowd.get_next_obstacle_vertex_id(i)
			local x2, y2 = crowd.get_obstacle_vertex(next_i)

			msg.post("@render:", "draw_line", {
				start_point = vmath.vector3(x1, y1, 0),
				end_point   = vmath.vector3(x2, y2, 0),
				color       = const.EDGE_COLOR
			})

			visited[i] = true
		end
	end
end

local function add_obstacles()
	crowd.add_obstacle(ARENA)

	--diamond
	local obst_pos    = go.get_position("/dia")
	local sprite_size = go.get("/dia#sprite", "size")
	local obst        = {}
	for _, vertex in pairs(DIA_OBST) do
		table.insert(obst, { x = vertex.x + (obst_pos.x - (sprite_size.x / 2)), y = vertex.y + (obst_pos.y - (sprite_size.y / 2)) })
	end
	local obst_id = crowd.add_obstacle(obst)

	--poly
	obst_pos      = go.get_position("/poly")
	sprite_size   = go.get("/poly#sprite", "size")
	obst          = {}
	for _, vertex in pairs(POLY_OBST) do
		table.insert(obst, { x = vertex.x + (obst_pos.x - (sprite_size.x / 2)), y = vertex.y + (obst_pos.y - (sprite_size.y / 2)) })
	end
	obst_id     = crowd.add_obstacle(obst)

	--rect
	obst_pos    = go.get_position("/rect")
	sprite_size = go.get("/rect#sprite", "size")
	obst        = {}
	for _, vertex in pairs(RECT_OBST) do
		table.insert(obst, { x = vertex.x + (obst_pos.x - (sprite_size.x / 2)), y = vertex.y + (obst_pos.y - (sprite_size.y / 2)) })
	end
	obst_id     = crowd.add_obstacle(obst)

	--star
	obst_pos    = go.get_position("/star")
	sprite_size = go.get("/star#sprite", "size")
	obst        = {}
	for _, vertex in pairs(STAR_OBST) do
		table.insert(obst, { x = vertex.x + (obst_pos.x - (sprite_size.x / 2)), y = vertex.y + (obst_pos.y - (sprite_size.y / 2)) })
	end
	obst_id     = crowd.add_obstacle(obst)

	--tri
	obst_pos    = go.get_position("/tri")
	sprite_size = go.get("/tri#sprite", "size")
	obst        = {}
	for _, vertex in pairs(TRI_OBST) do
		table.insert(obst, { x = vertex.x + (obst_pos.x - (sprite_size.x / 2)), y = vertex.y + (obst_pos.y - (sprite_size.y / 2)) })
	end
	obst_id = crowd.add_obstacle(obst)

	crowd.process_obstacles()
end

function init(self)
	msg.post(".", "acquire_input_focus")

	crowd.init(MAX_AGENTS, 4, 90, 0, 1)

	if RUN_SIMULATION then
		crowd.init_gameobjects()
	end

	crowd.run_simulation(RUN_SIMULATION)

	if MAX_WORKERS > 1 then
		step_update = crowd.do_step_parallel
	end

	add_obstacles()

	for i = 1, GOAL_COUNT do
		table.insert(goals, go.get_position("goal_" .. tostring(i)))
	end

	agent.set_spawn_max_distance(20)
end

function update(self, dt)
	draw_arena_bounds(ARENA)
	draw_obstacles()

	if RUN_SIMULATION or data.agent_count == 0 then
		return
	end

	crowd.set_time_step(dt)

	agent.set_preferred_velocities(dt)

	step_update()

	agent.update_game_objects()
end

function on_input(self, action_id, action)
	cam.input(action_id)

	if action_id == const.TRIGGER.MOUSE_BUTTON_LEFT and action.pressed then
		local mouse_pos = vmath.vector3(action.screen_x, action.screen_y, 0)
		mouse_pos = camera.screen_to_world(mouse_pos, const.CAMERA)
		agent.add(10, mouse_pos, goals[rnd.range(const.RND_ID, 1, GOAL_COUNT)], RUN_SIMULATION, nil, nil, nil, 50, 150)
	end
end
