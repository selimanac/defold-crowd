local const            = require "defold-files.examples.scripts.lib.const"

local BLUE_RADIUS      = 64.0
local PINK_RADIUS      = 64.0
local SPEED            = 460.0
local NEIGHBOR_DIST    = 520.0
local TIME_HORIZON     = 1.0
local TIME_HORIZON_OBS = 0.0
local MAX_NEIGHBORS    = 2
local VEL_SCALE        = 0.18
local ORCA_HALF_LEN    = 150.0
local TRAIL_LENGTH     = 80
local Y_OFFSET         = 0.01 -- perpendicular bias to break head-on ORCA deadlock

local COLOR_PREF       = vmath.vector4(80 / 255, 190 / 255, 255 / 255, 255)
local COLOR_VEL        = vmath.vector4(255 / 255, 245 / 255, 80 / 255, 255)
local COLOR_ORCA       = vmath.vector4(0, 140 / 255, 60 / 255, 255)
local COLOR_TRAIL_BLUE = vmath.vector4(90 / 255, 215 / 255, 255 / 255, 255)
local COLOR_TRAIL_PINK = vmath.vector4(255 / 255, 130 / 255, 130 / 255, 255)
local COLOR_LANE       = vmath.vector4(1, 1, 1, 24 / 255)

-- Blue Weight, Blue Priority [, Pink Lock]}
local PAIR_CONFIGS     = {
	{ 1.0,   0 },
	{ 16.0,  0 },
	{ 1.0,   10 },
	{ 120.0, 120 },
	{ 1.0,   0,  0.3 }, -- agent locks at 30% of the lane
}

local agents           = {}
local initials         = nil -- cached on first init, reused on restart

-- ************************
-- Debug lines
-- ************************
local function init_trail(agent, x, y)
	local t = {}
	for k = 1, TRAIL_LENGTH do
		t[k] = { x = x, y = y }
	end
	agent.trail       = t
	agent.trail_count = 1
	agent.trail_next  = 2
end

local function push_trail(agent, x, y)
	agent.trail[agent.trail_next] = { x = x, y = y }
	agent.trail_next = agent.trail_next % TRAIL_LENGTH + 1
	if agent.trail_count < TRAIL_LENGTH then
		agent.trail_count = agent.trail_count + 1
	end
end

local function draw_debug_lines()
	for _, agent in ipairs(agents) do
		msg.post("@render:", "draw_line", {
			start_point = vmath.vector3(agent.start_x, agent.start_y, 0),
			end_point   = vmath.vector3(agent.goal_x, agent.goal_y, 0),
			color       = COLOR_LANE,
		})

		local count = agent.trail_count
		if count >= 2 then
			local oldest = (agent.trail_next - 1 + TRAIL_LENGTH - count) % TRAIL_LENGTH
			for s = 1, count - 1 do
				local a = agent.trail[(oldest + s - 1) % TRAIL_LENGTH + 1]
				local b = agent.trail[(oldest + s) % TRAIL_LENGTH + 1]
				msg.post("@render:", "draw_line", {
					start_point = vmath.vector3(a.x, a.y, 0),
					end_point   = vmath.vector3(b.x, b.y, 0),
					color       = agent.trail_color,
				})
			end
		end

		local px, py   = crowd.get_agent_position(agent.id)
		local pos      = vmath.vector3(px, py, 0)

		local pfx, pfy = crowd.get_agent_pref_velocity(agent.id)
		if pfx * pfx + pfy * pfy > 0.0001 then
			msg.post("@render:", "draw_line", {
				start_point = pos,
				end_point   = vmath.vector3(px + pfx * VEL_SCALE, py + pfy * VEL_SCALE, 0),
				color       = COLOR_PREF,
			})
		end

		local vx, vy = crowd.get_agent_velocity(agent.id)
		if vx * vx + vy * vy > 0.0001 then
			msg.post("@render:", "draw_line", {
				start_point = pos,
				end_point   = vmath.vector3(px + vx * VEL_SCALE, py + vy * VEL_SCALE, 0),
				color       = COLOR_VEL,
			})
		end

		local n = crowd.get_agent_num_orca_lines(agent.id)
		for li = 0, n - 1 do
			local opx, opy, odx, ody = crowd.get_agent_orca_line(agent.id, li)
			local cx = px + opx * VEL_SCALE
			local cy = py + opy * VEL_SCALE
			msg.post("@render:", "draw_line", {
				start_point = vmath.vector3(cx - odx * ORCA_HALF_LEN, cy - ody * ORCA_HALF_LEN, 0),
				end_point   = vmath.vector3(cx + odx * ORCA_HALF_LEN, cy + ody * ORCA_HALF_LEN, 0),
				color       = COLOR_ORCA,
			})
		end
	end
end

local function setup()
	agents = {}

	if not initials then
		initials = {}
		for i = 1, 5 do
			initials[i] = {
				blue_id       = go.get_id("player_" .. i),
				pink_id       = go.get_id("agent_" .. i),
				blue_position = go.get_position("player_" .. i),
				pink_position = go.get_position("agent_" .. i),
				blue_goal     = go.get_position("goal_" .. i),
			}
		end
	else
		for i = 1, 5 do
			go.set_position(initials[i].blue_position, initials[i].blue_id)
			go.set_position(initials[i].pink_position, initials[i].pink_id)
		end
	end

	crowd.init(10, MAX_NEIGHBORS, 0, 0, 1)

	for i = 1, 5 do
		local agent_config = PAIR_CONFIGS[i]
		local orig         = initials[i]
		local large_y      = orig.blue_position.y + Y_OFFSET
		local small_y      = orig.pink_position.y - Y_OFFSET
		local blue_id      = crowd.add_agent(orig.blue_position.x, large_y, BLUE_RADIUS, SPEED, MAX_NEIGHBORS, NEIGHBOR_DIST, TIME_HORIZON, TIME_HORIZON_OBS)

		crowd.set_agent_avoidance_weight(blue_id, agent_config[1])
		crowd.set_agent_avoidance_priority(blue_id, agent_config[2])
		crowd.set_agent_pref_velocity(blue_id, 0, 0)

		local pink_id = crowd.add_agent(orig.pink_position.x, small_y, PINK_RADIUS, SPEED, MAX_NEIGHBORS, NEIGHBOR_DIST, TIME_HORIZON, TIME_HORIZON_OBS)

		crowd.set_agent_avoidance_weight(pink_id, 1.0)
		crowd.set_agent_avoidance_priority(pink_id, 0)
		crowd.set_agent_pref_velocity(pink_id, 0, 0)

		local agent_blue = {
			id          = blue_id,
			instance    = orig.blue_id,
			start_x     = orig.blue_position.x,
			start_y     = large_y,
			goal_x      = orig.blue_goal.x,
			goal_y      = orig.blue_goal.y,
			radius      = BLUE_RADIUS,
			has_goal    = true,
			trail_color = COLOR_TRAIL_BLUE,
		}

		go.set_position(vmath.vector3(orig.blue_position.x, large_y, 0), orig.blue_id)

		init_trail(agent_blue, orig.blue_position.x, large_y)

		local agent_pink = {
			id          = pink_id,
			instance    = orig.pink_id,
			start_x     = orig.pink_position.x,
			start_y     = small_y,
			goal_x      = orig.blue_position.x,
			goal_y      = orig.blue_position.y,
			radius      = PINK_RADIUS,
			has_goal    = true,
			trail_color = COLOR_TRAIL_PINK,
		}

		go.set_position(vmath.vector3(orig.pink_position.x, small_y, 0), orig.pink_id)

		if agent_config[3] then
			agent_pink.lock_x    = orig.pink_position.x + (orig.blue_position.x - orig.pink_position.x) * agent_config[3]
			agent_pink.is_locked = false
		end

		init_trail(agent_pink, orig.pink_position.x, small_y)

		agents[#agents + 1] = agent_blue
		agents[#agents + 1] = agent_pink
	end
end

local function set_pref_velocities()
	for _, agent in ipairs(agents) do
		if agent.lock_x and not agent.is_locked then
			local px, py = crowd.get_agent_position(agent.id)
			local reached = (agent.start_x > agent.goal_x and px <= agent.lock_x)
				or (agent.start_x < agent.goal_x and px >= agent.lock_x)
			if reached then
				agent.is_locked = true
				agent.has_goal  = false
				crowd.set_agent_avoidance_locked(agent.id, true)
			end
		end

		if not agent.has_goal then
			crowd.set_agent_pref_velocity(agent.id, 0, 0)
		else
			local px, py = crowd.get_agent_position(agent.id)
			local dx     = agent.goal_x - px
			local dy     = agent.goal_y - py
			local dist   = math.sqrt(dx * dx + dy * dy)
			if dist < agent.radius then
				agent.has_goal = false
				crowd.set_agent_pref_velocity(agent.id, 0, 0)
			else
				local s = SPEED / dist
				crowd.set_agent_pref_velocity(agent.id, dx * s, dy * s)
			end
		end
	end
end

local function update_positions()
	for _, agent in ipairs(agents) do
		local x, y = crowd.get_agent_position(agent.id)
		go.set_position(vmath.vector3(x, y, 0), agent.instance)
		push_trail(agent, x, y)
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	setup()
end

function update(self, dt)
	set_pref_velocities()

	crowd.set_time_step(dt)

	crowd.do_step()

	update_positions()

	draw_debug_lines()
end

function on_input(self, action_id, action)
	if action_id == const.TRIGGER.KEY_SPACE and action.pressed then
		crowd.destroy()
		setup()
	end
end

function final(self)
	crowd.destroy()
end
